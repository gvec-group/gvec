# bash source script for loading modules on mpcdf shared runner (images from 2024)
# LAST MODIFIED: 2026-01-10
# ===========================================

module purge
module load git
module load cmake
module load intel
module load impi
module load mkl
module load hdf5-serial
module load netcdf-serial
module load anaconda/3/2023.03  # for pytest

module list
export FC=`which mpiifx`
export CC=`which mpiicx`
export CXX=`which mpiicx`
#for anaconda to not have an error in `import gvec`
export LD_PRELOAD="/usr/lib64/libcrypto.so /usr/lib64/libssl.so"
